# ============================================================
# API Keys (local .env only, gitignored; no key may ever appear in frontend/CI)
# Copy this file to .env and fill in real values: cp .env.example .env
# ============================================================

# When enabled, config/public_sources.yaml is the only authority for provider
# construction, network collection, and cache replay. Set DATA_DATA_DIR to an isolated
# staging directory; public/data contains legacy source payloads.
DATA_APPROVED_SOURCES_ONLY=false

# FRED API key (free signup: https://fred.stlouisfed.org/docs/api/api_key.html)
DATA_FRED_API_KEY=

# CoinGecko Demo key (free signup: https://www.coingecko.com/en/developers/dashboard)
DATA_COINGECKO_API_KEY=

# Financial Modeling Prep free-tier key (free signup: https://site.financialmodelingprep.com/)
DATA_FMP_API_KEY=

# Optional local BLS macro source; cloud runners also need a durable request ledger.
DATA_BLS_ENABLED=false

# Cloud checkpoints are an explicit opt-in. Provision the shared state branch and
# initialize its BLS and Treasury files before enabling either source.
# Reservations are written before requests. Missing or corrupt state never falls
# back to local data or to FRED. Do not reset or delete the branch while writers run.
DATA_BLS_CLOUD_ENABLED=false
DATA_TREASURY_CLOUD_ENABLED=false
DATA_CLOUD_STATE_REPO=
DATA_CLOUD_STATE_BRANCH=cloud-state
# Inject the credential as a runner secret. Never commit its value.
DATA_CLOUD_STATE_TOKEN=
DATA_BLS_CHECKPOINT_PATH=bls/ledger.json
DATA_TREASURY_CHECKPOINT_PATH=treasury/ledger.json

# Noncommercial publication only. Coin Metrics Community BTC/ETH USD reference rates.
# CC BY-NC 4.0, with attribution and processing notices rendered in the crypto UI.
# Replaces the crypto provider chain and isolates its cache. No CoinGecko fallback.
DATA_COINMETRICS_ENABLED=false

# Optional Treasury daily CMT source. Its local history lock does not coordinate cloud runners.
DATA_TREASURY_ENABLED=false
